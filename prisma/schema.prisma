generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model StoreConfig {
  id                    String   @id @default(uuid())
  shopDomain            String   @unique
  markupType            String   @default("PERCENTAGE")
  markupValue           Int      @default(15)
  freeShippingThreshold Int      @default(10000)
  packageLength         Int      @default(10)
  packageWidth          Int      @default(5)
  packageHeight         Int      @default(5)
  isActiveCTT           Boolean  @default(true)
  isActiveGLS           Boolean  @default(true)
  isActiveFedEx         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GlsEuroZone {
  id          String @id @default(uuid())
  countryCode String @unique
  zoneName    String
}

model GlsPricing {
  id        String @id @default(uuid())
  zoneName  String
  sizeLabel String
  basePrice Float

  @@unique([zoneName, sizeLabel])
}

model GlsDeliveryTime {
  id       String @id @default(uuid())
  zoneName String @unique
  minDays  Int
  maxDays  Int
}

model CttZoneMatrix {
  id          String @id @default(uuid())
  originDigit String
  destDigit   String
  zoneName    String

  @@unique([originDigit, destDigit])
}

model CttPricing {
  id          String @id @default(uuid())
  weightLabel String
  maxWeight   Float  @unique
  priceT1     Float
  priceT2     Float
}

model CttIslandsPricing {
  id          String @id @default(uuid())
  weightLabel String
  maxWeight   Float  @unique
  price       Float
}
