generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model StoreConfig {
  id                    String   @id @default(uuid())
  shopDomain            String   @unique
  freeShippingActive    Boolean  @default(true)
  freeShippingThreshold Int      @default(10000)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PostalRule {
  id          String   @id @default(uuid())
  shopDomain  String
  countryCode String   // e.g., 'PT', 'ES', 'GB'
  groupName   String   // The Zone name, e.g., 'PT Continental', 'Ilhas', 'Europa'
  matchType   String   // Expected values: 'ALL', 'EXACT', 'PREFIX', 'RANGE'
  valueMin    String   // Stores exact value, prefix, or the start of a range. Empty if 'ALL'
  valueMax    String?  // Stores the end of the range (if matchType is 'RANGE')

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopDomain, countryCode])
}

model Carrier {
  id                  String   @id @default(uuid())
  shopDomain          String
  name                String
  description         String   @default("")
  category            String   @default("Nacional")// "Nacional" or "International"
  calculationMethod   String   // "API" or "TABLE"
  isActive            Boolean  @default(true)
  
  // Fields for API integration
  apiKey              String?
  apiSecret           String?
  apiAccountNumber    String?
  apiUrlRates         String?
  apiUrlAvailability  String?
  markupType          String?  @default("PERCENTAGE")
  markupValue         Float?   @default(0)

  // Relation to manual rates (for TABLE method)
  rates             CarrierRate[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shopDomain])
}

model CarrierRate {
  id              String  @id @default(uuid())
  carrierId       String
  carrier         Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  
  groupName       String  @default("PT")
  maxWeight       Float     
  price           Float
  deliveryTime    Int     @default(3)

  @@index([carrierId])
}