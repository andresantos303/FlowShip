generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model StoreConfig {
  id                    String   @id @default(uuid())
  shopDomain            String   @unique
  markupType            String   @default("PERCENTAGE")
  markupValue           Int      @default(15)
  freeShippingThreshold Int      @default(10000)
  packageLength         Int      @default(10)
  packageWidth          Int      @default(5)
  packageHeight         Int      @default(5)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Carrier {
  id                String   @id @default(uuid())
  shopDomain        String
  name              String
  calculationMethod String   // "API" or "TABLE"
  isActive          Boolean  @default(true)
  
  // Fields for API integration
  apiKey            String?
  apiSecret         String?
  markupType        String?  @default("PERCENTAGE")
  markupValue       Float?   @default(0)

  // Relation to manual rates (for TABLE method)
  rates             CarrierRate[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shopDomain])
}

model CarrierRate {
  id              String  @id @default(uuid())
  carrierId       String
  carrier         Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  
  countryCode     String
  postalCodeStart String? // e.g., '1000'
  postalCodeEnd   String? // e.g., '1999'
  maxWeight       Float   // Maximum weight for this price tier
  maxVolume       Float?  // Maximum volume (optional)
  price           Float   // The agreed price

  @@index([carrierId])
}