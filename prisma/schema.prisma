generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model StoreConfig {
  id                    String   @id @default(uuid())
  shopDomain            String   @unique
  freeShippingActive    Boolean  @default(true)
  freeShippingThreshold Int      @default(10000)
  // Configurações da Caixa Pequena
  boxSmallMaxWeight     Float    @default(2.0)
  boxSmallLength        Int      @default(20)
  boxSmallWidth         Int      @default(15)
  boxSmallHeight        Int      @default(10)

  // Configurações da Caixa Média
  boxMediumMaxWeight    Float    @default(5.0)
  boxMediumLength       Int      @default(30)
  boxMediumWidth        Int      @default(20)
  boxMediumHeight       Int      @default(15)

  // Configurações da Caixa Grande
  boxLargeMaxWeight     Float    @default(30.0)
  boxLargeLength        Int      @default(50)
  boxLargeWidth         Int      @default(40)
  boxLargeHeight        Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model CountryGroup {
  id          String   @id @default(uuid())
  countryName String
  countryCode String   // Ex: 'PT', 'ES', 'FR'
  groupName   String   // Ex: 'Nacional', 'Europa 1'

  @@unique([countryCode])
}

model Carrier {
  id                  String   @id @default(uuid())
  shopDomain          String
  name                String
  description         String   @default("")
  category            String   @default("Nacional")// "Nacional" or "International"
  calculationMethod   String   // "API" or "TABLE"
  isActive            Boolean  @default(true)
  
  // Fields for API integration
  apiKey              String?
  apiSecret           String?
  apiAccountNumber    String?
  apiUrlRates         String?
  apiUrlAvailability  String?
  markupType          String?  @default("PERCENTAGE")
  markupValue         Float?   @default(0)

  // Relation to manual rates (for TABLE method)
  rates             CarrierRate[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shopDomain])
}

model CarrierRate {
  id              String  @id @default(uuid())
  carrierId       String
  carrier         Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  
  groupName       String  @default("PT")
  boxSize         String  @default("SMALL")// "SMALL", "MEDIUM" ou "LARGE"
  maxWeight       Int     @default(10)
  price           Float   // The agreed price
  deliveryTime    Int     @default(3)

  @@index([carrierId])
}